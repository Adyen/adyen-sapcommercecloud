<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="adyencockpitManagementApiClient" class="com.adyen.cockpit.setup.ManagementApiClient">
        <property name="configurationService" ref="configurationService"/>
    </bean>

    <bean id="adyencockpitSetupService" class="com.adyen.cockpit.setup.DefaultCockpitSetupService">
        <property name="baseStoreService" ref="baseStoreService"/>
        <property name="modelService" ref="modelService"/>
        <property name="configurationService" ref="configurationService"/>
        <property name="managementApiClient" ref="adyencockpitManagementApiClient"/>
    </bean>

    <bean id="adyencockpitRouteRegistry" class="com.adyen.cockpit.api.DefaultCockpitRouteRegistry"/>

    <bean id="adyencockpitAccess" class="com.adyen.cockpit.api.CockpitAccess"/>

    <bean id="adyencockpitBootstrapRoute" class="com.adyen.cockpit.api.routes.BootstrapRoute">
        <property name="access" ref="adyencockpitAccess"/>
        <property name="userService" ref="userService"/>
        <property name="baseStoreService" ref="baseStoreService"/>
    </bean>

    <bean id="adyencockpitSetupStoresRoute" class="com.adyen.cockpit.setup.routes.SetupStoresRoute"
          parent="adyencockpitSetupRouteParent"/>
    <bean id="adyencockpitSetupMerchantAccountsRoute" class="com.adyen.cockpit.setup.routes.SetupMerchantAccountsRoute"
          parent="adyencockpitSetupRouteParent"/>
    <bean id="adyencockpitSetupManagementKeyRoute" class="com.adyen.cockpit.setup.routes.SetupManagementKeyRoute"
          parent="adyencockpitSetupRouteParent"/>
    <bean id="adyencockpitSetupMerchantAccountRoute" class="com.adyen.cockpit.setup.routes.SetupMerchantAccountRoute"
          parent="adyencockpitSetupRouteParent"/>
    <bean id="adyencockpitSetupProvisionRoute" class="com.adyen.cockpit.setup.routes.SetupProvisionRoute"
          parent="adyencockpitSetupRouteParent"/>

    <!-- Shared wiring of the setup routes; abstract, so it is not a route itself. -->
    <bean id="adyencockpitSetupRouteParent" abstract="true">
        <property name="setupService" ref="adyencockpitSetupService"/>
        <property name="baseStoreService" ref="baseStoreService"/>
    </bean>

</beans>
