<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

	<context:annotation-config/>

	<!-- The controller is found by scanning, exactly as the storefront's other addon controllers are. A
	     class outside this package is not picked up, which is worth knowing before moving one. -->
	<context:component-scan base-package="com.adyen.commerce.subscription.controllers"/>

</beans>
