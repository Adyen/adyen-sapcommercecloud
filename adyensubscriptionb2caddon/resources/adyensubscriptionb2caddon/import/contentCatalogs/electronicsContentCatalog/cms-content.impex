# -----------------------------------------------------------------------
# The "My subscriptions" page in My Account - sample-data variant.
#
# The twin of ../template/cms-content.impex. This one is read by the sample-data listener and names its
# catalogue; that one is read by the core-data listener and takes the catalogue as a parameter. Both are
# needed: an environment initialised without sample data gets the page only from the template half, and an
# environment that imports sample data for this catalogue gets it from here. Change one, change the other.
#
# Seven blocks, all of them required. Leave one out and the result is not an error message but a symptom:
# no ContentPage gives CMSItemNotFoundException, no ContentSlot or component gives a blank page under the
# right heading, and no navigation node gives a page nobody can find.
#
# Written to BOTH catalogue versions. The sibling addon's file writes only to Staged, and the storefront
# serves Online - which is why its stored-cards page does not appear until somebody syncs the catalogue by
# hand, and why that has been mistaken for a broken addon more than once.
#
# Note the document ids (&linkRefStaged, &linkRefOnline, ...). They are scoped to the whole import run, not
# to a block, so the Staged and Online halves must not share one: reusing it fails the second half with
# "id ... already used for item with pk=...", which leaves Staged populated, Online empty, and the
# storefront - which serves Online - showing nothing.
# -----------------------------------------------------------------------
$contentCatalog=electronicsContentCatalog
$contentCVS=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$contentCatalog]),CatalogVersion.version[default=Staged])[default=$contentCatalog:Staged]
$contentCVO=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$contentCatalog]),CatalogVersion.version[default=Online])[default=$contentCatalog:Online]
$addonExtensionName=adyensubscriptionb2caddon

# 1. The page itself. The label is the URL the controller is mapped to; the two must agree or the
#    controller renders a page the CMS cannot resolve.
INSERT_UPDATE ContentPage;$contentCVS[unique=true];uid[unique=true];name;masterTemplate(uid,$contentCVS);label;defaultPage[default='true'];approvalStatus(code)[default='approved'];homepage[default='false']
;;adyenSubscriptions;My Subscriptions;AccountPageTemplate;/my-account/subscriptions
INSERT_UPDATE ContentPage;$contentCVO[unique=true];uid[unique=true];name;masterTemplate(uid,$contentCVO);label;defaultPage[default='true'];approvalStatus(code)[default='approved'];homepage[default='false']
;;adyenSubscriptions;My Subscriptions;AccountPageTemplate;/my-account/subscriptions

# 2. The link the navigation entry points at.
INSERT_UPDATE CMSLinkComponent;$contentCVS[unique=true];uid[unique=true];name;url;&linkRefStaged;target(code)[default='sameWindow']
;;AdyenSubscriptionsLink;AdyenSubscriptionsLink;/my-account/subscriptions;AdyenSubscriptionsLink;
INSERT_UPDATE CMSLinkComponent;$contentCVO[unique=true];uid[unique=true];name;url;&linkRefOnline;target(code)[default='sameWindow']
;;AdyenSubscriptionsLink;AdyenSubscriptionsLink;/my-account/subscriptions;AdyenSubscriptionsLink;

# 3. Its place in the My Account menu. MyAccountNavNode belongs to the base accelerator catalogue, not to
#    this addon - a project that renamed it will fail here, which is the right moment to find out.
#    `links` is left empty on purpose: block 4 binds the link through a CMSNavigationEntry, and filling
#    both would attach it twice and show the menu item twice.
INSERT_UPDATE CMSNavigationNode;uid[unique=true];$contentCVS[unique=true];name;parent(uid,$contentCVS);links(&linkRefStaged)[mode=append];&nodeRefStaged
;AdyenSubscriptionsNavNode;;AdyenSubscriptionsNavNode;MyAccountNavNode;;AdyenSubscriptionsNavNode
INSERT_UPDATE CMSNavigationNode;uid[unique=true];$contentCVO[unique=true];name;parent(uid,$contentCVO);links(&linkRefOnline)[mode=append];&nodeRefOnline
;AdyenSubscriptionsNavNode;;AdyenSubscriptionsNavNode;MyAccountNavNode;;AdyenSubscriptionsNavNode

# 4. What ties the node to the link.
INSERT_UPDATE CMSNavigationEntry;uid[unique=true];$contentCVS[unique=true];name;navigationNode(&nodeRefStaged);item(&linkRefStaged)
;AdyenSubscriptionsNavNodeEntry;;AdyenSubscriptionsNavNodeEntry;AdyenSubscriptionsNavNode;AdyenSubscriptionsLink
INSERT_UPDATE CMSNavigationEntry;uid[unique=true];$contentCVO[unique=true];name;navigationNode(&nodeRefOnline);item(&linkRefOnline)
;AdyenSubscriptionsNavNodeEntry;;AdyenSubscriptionsNavNodeEntry;AdyenSubscriptionsNavNode;AdyenSubscriptionsLink

# 5. The component that renders the JSP. The path resolves inside the storefront after addoninstall has
#    copied the view there. The empty `actions` column is carried because the header and the row have to
#    have the same width, and the precedent's rows leave it blank.
INSERT_UPDATE JspIncludeComponent;$contentCVS[unique=true];uid[unique=true];name;page;actions(uid,$contentCVS)
;;AdyenAccountSubscriptionsComponent;Adyen Account Subscriptions Component;/WEB-INF/views/addons/$addonExtensionName/responsive/pages/account/accountSubscriptionsPage.jsp;
INSERT_UPDATE JspIncludeComponent;$contentCVO[unique=true];uid[unique=true];name;page;actions(uid,$contentCVO)
;;AdyenAccountSubscriptionsComponent;Adyen Account Subscriptions Component;/WEB-INF/views/addons/$addonExtensionName/responsive/pages/account/accountSubscriptionsPage.jsp;

# 6. The menu wording. Its own block because linkName is localised and cannot travel in the INSERT above.
UPDATE CMSLinkComponent;$contentCVS[unique=true];uid[unique=true];linkName[lang=en]
;;AdyenSubscriptionsLink;"Subscriptions"
UPDATE CMSLinkComponent;$contentCVO[unique=true];uid[unique=true];linkName[lang=en]
;;AdyenSubscriptionsLink;"Subscriptions"

# 7. The slot, and the slot's place on the page.
INSERT_UPDATE ContentSlot;$contentCVS[unique=true];uid[unique=true];name;active;cmsComponents(uid,$contentCVS)
;;BodyContent-adyenSubscriptions;Body Content Slot for My Subscriptions;true;AdyenAccountSubscriptionsComponent
INSERT_UPDATE ContentSlot;$contentCVO[unique=true];uid[unique=true];name;active;cmsComponents(uid,$contentCVO)
;;BodyContent-adyenSubscriptions;Body Content Slot for My Subscriptions;true;AdyenAccountSubscriptionsComponent

INSERT_UPDATE ContentSlotForPage;$contentCVS[unique=true];uid[unique=true];position[unique=true];page(uid,$contentCVS)[unique=true][default='adyenSubscriptions'];contentSlot(uid,$contentCVS)[unique=true]
;;BodyContent-adyenSubscriptions;BodyContent;;BodyContent-adyenSubscriptions
INSERT_UPDATE ContentSlotForPage;$contentCVO[unique=true];uid[unique=true];position[unique=true];page(uid,$contentCVO)[unique=true][default='adyenSubscriptions'];contentSlot(uid,$contentCVO)[unique=true]
;;BodyContent-adyenSubscriptions;BodyContent;;BodyContent-adyenSubscriptions
