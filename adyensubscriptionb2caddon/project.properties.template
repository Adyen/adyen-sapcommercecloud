# -----------------------------------------------------------------------
# My Account subscriptions page for the B2C accelerator.
#
# This template is the source of truth: `ant addoninstall` regenerates project.properties from it and
# rewrites the yacceleratorstorefront prefix below into the storefront the addon is installed into. Editing
# the generated file instead is how a change survives exactly until the next install.
# -----------------------------------------------------------------------

adyensubscriptionb2caddon.application-context=adyensubscriptionb2caddon-spring.xml

# The line that makes the stylesheet reach the page. Without it addoninstall copies the file into the
# storefront and nothing ever links it: the markup ships restyled and unstyled at once, which looks exactly
# like a deployment that did not happen.
#
# It belongs in the TEMPLATE and not in project.properties, because addoninstall deletes that file and
# regenerates it from here every time it runs - an edit made there survives until the next install and then
# vanishes, which is a worse failure than never having made it.
#
# Keyed on the addon name rather than the storefront, so it holds whichever accelerator storefront the
# environment installs into. That matters here: this workspace builds against yb2cacceleratorstorefront and
# the dev environment against yacceleratorstorefront.
adyensubscriptionb2caddon.css.paths.responsive=/responsive/common/css/adyensubscriptionb2caddon.css;

# Registers this addon's web context with the storefront. Without it the controller is never scanned and
# /my-account/subscriptions is a 404 with nothing in the log to say why.
yacceleratorstorefront.additionalWebSpringConfigs.adyensubscriptionb2caddon=classpath:/adyensubscriptionb2caddon/web/spring/adyensubscriptionb2caddon-web-spring.xml

# Deliberately no csrf.allowed.url.patterns entry. The cancellation is a POST and POST is the only method
# this storefront's matcher checks, so an exclusion here would be the one change that quietly removes the
# page's only protection against a forged request.
