<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
 Copyright (c) 2026 Adyen B.V. - MIT license.

 adyenchargebeeconnector - Chargebee adapter of the SubscriptionBillingConnector SPI.
 First external adapter: Adyen keeps processing the recurring payments, Chargebee only
 orchestrates the billing. Implements the port defined in adyensubscriptionconnector.
-->
<extensioninfo xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="extensioninfo.xsd">

    <extension abstractclassprefix="Generated" classprefix="Adyenchargebeeconnector" jaloLogicFree="true"
               managername="AdyenchargebeeconnectorManager"
               managersuperclass="de.hybris.platform.jalo.extension.Extension"
               name="adyenchargebeeconnector" usemaven="false">

        <!-- The SPI + normalized model come from the core; httpclient5 + jackson come
             transitively from adyenv6core (usemaven=false: no own maven deps needed). -->
        <requires-extension name="adyensubscriptionconnector"/>
        <requires-extension name="adyenv6core"/>

        <coremodule generated="true"
                    manager="com.adyen.commerce.connector.chargebee.jalo.AdyenchargebeeconnectorManager"
                    packageroot="com.adyen.commerce.connector.chargebee"/>

        <!-- Contributes Backoffice configuration and labels only; with no Backoffice code it does not
             require the backoffice extension. -->
        <meta key="backoffice-module" value="true"/>
    </extension>

</extensioninfo>
