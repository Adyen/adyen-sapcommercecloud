<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="adyenManagementService" class="com.adyen.backoffice.service.impl.AdyenManagementServiceImpl">
        <property name="configurationService" ref="configurationService"/>
        <property name="adyenSetupService" ref="adyenSetupService"/>
    </bean>

    <bean id="adyenSetupService" class="com.adyen.backoffice.service.impl.DefaultAdyenSetupService">
        <property name="configurationService" ref="configurationService"/>
        <property name="modelService" ref="modelService"/>
        <property name="baseStoreService" ref="baseStoreService"/>
    </bean>

    <bean id="adyenProvisioningService" class="com.adyen.backoffice.service.impl.DefaultAdyenProvisioningService">
        <property name="configurationService" ref="configurationService"/>
        <property name="modelService" ref="modelService"/>
        <property name="adyenSetupService" ref="adyenSetupService"/>
    </bean>
</beans>
