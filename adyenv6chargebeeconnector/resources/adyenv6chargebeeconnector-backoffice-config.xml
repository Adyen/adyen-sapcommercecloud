 Backoffice configuration for the Chargebee connector. Loaded only while this extension is, so the
 Chargebee fields and types never appear on an installation that cannot use them. The tab and tree node
 they join belong to adyensubscriptionconnector.
-->
<config xmlns="http://www.hybris.com/cockpit/config"
        xmlns:lv="http://www.hybris.com/cockpitng/component/listView"
        xmlns:as="http://www.hybris.com/cockpitng/config/advancedsearch">

    <context merge-by="type" type="BaseStore" component="editor-area">
        <editorArea:editorArea xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea">
            <editorArea:tab name="hmc.adyen.subscriptionBilling">
                <editorArea:section name="hmc.adyen.chargebeeConfig">
                    <editorArea:attribute qualifier="chargebeeConfig"/>
                </editorArea:section>
            </editorArea:tab>
        </editorArea:editorArea>
    </context>

    <!-- Created from the base store editor above, through the chargebeeConfig reference. Without an explicit
         wizard Backoffice offers only the attributes the type system marks mandatory, which drops
         adyenGatewayMerchantAccount from the form: it is optional at type level so rows saved before it existed
         stay saveable, yet the connector refuses to import a token without it. Listing it here puts it in front
         of the operator while they fill the form.

         The encrypted fields get the password editor, as the base store's API key does, so a full-access key is
         never typed into a field that shows it in the clear. -->
    <context merge-by="type" type="ChargebeeConfig" component="create-wizard">
        <wz:flow xmlns:wz="http://www.hybris.com/cockpitng/config/wizard-config"
                 id="AdyenChargebeeConfigWizard" title="create.title(ctx.TYPE_CODE)">
            <wz:step id="step1" label="hmc.adyen.subscriptionConfig.step">
                <wz:content id="step1.content" merge-mode="replace">
                    <wz:property qualifier="newObject.subscriptionSiteId"/>
                    <wz:property qualifier="newObject.subscriptionApiKey"
                                 editor="com.hybris.cockpitng.editor.defaultpassword"/>
                    <wz:property qualifier="newObject.subscriptionGatewayAccountId"/>
                    <wz:property qualifier="newObject.adyenGatewayMerchantAccount"/>
                    <wz:property qualifier="newObject.chargebeeWebhookUsername"/>
                    <wz:property qualifier="newObject.chargebeeWebhookPassword"
                                 editor="com.hybris.cockpitng.editor.defaultpassword"/>
                </wz:content>
            </wz:step>
        </wz:flow>
    </context>

    <!-- A plan mapping is the one row an operator creates by hand before any subscription activity can appear:
         with no mapping the activator treats every order as non-subscription and exits without a trace. It goes
         after the activity nodes adyensubscriptionconnector puts in the same folder. -->
    <context merge-by="module" parent="auto" component="explorer-tree">
        <explorer-tree:explorer-tree xmlns:explorer-tree="http://www.hybris.com/cockpitng/config/explorertree">
            <explorer-tree:navigation-node id="hmc_treenode_system" merge-mode="append">
                <explorer-tree:navigation-node id="adyen.subscriptionBilling">
                    <explorer-tree:type-node code="ChargebeePlanMapping" id="adyen.chargebeePlanMapping"/>
                </explorer-tree:navigation-node>
            </explorer-tree:navigation-node>
        </explorer-tree:explorer-tree>
    </context>

    <!-- Plan mappings: which SAP product is sold as which Chargebee item price. Unique on
         (productCode, baseStore); an empty base store is the default for stores without their own row, and a
         store's row wins. -->
    <context merge-by="type" parent="GenericItem" type="ChargebeePlanMapping" component="listview">
        <lv:list-view>
            <lv:column qualifier="productCode"/>
            <lv:column qualifier="baseStore"/>
            <lv:column qualifier="itemPriceId"/>
            <lv:column qualifier="priceId"/>
        </lv:list-view>
    </context>

    <context merge-by="type" parent="GenericItem" type="ChargebeePlanMapping" component="advanced-search">
        <as:advanced-search>
            <as:field-list>
                <as:field name="productCode" selected="true"/>
                <as:field name="baseStore" selected="true"/>
                <as:field name="itemPriceId" selected="true"/>
            </as:field-list>
        </as:advanced-search>
    </context>

    <context merge-by="type" type="ChargebeePlanMapping" component="editor-area">
        <editorArea:editorArea xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea">
            <editorArea:tab name="hmc.adyen">
                <editorArea:section name="hmc.adyen.planMapping">
                    <editorArea:attribute qualifier="productCode"/>
                    <editorArea:attribute qualifier="baseStore"/>
                    <editorArea:attribute qualifier="itemPriceId"/>
                    <editorArea:attribute qualifier="priceId"/>
                </editorArea:section>
            </editorArea:tab>
        </editorArea:editorArea>
    </context>

    <!-- Explicit: the default wizard shows only mandatory attributes and would drop priceId and baseStore. -->
    <context merge-by="type" type="ChargebeePlanMapping" component="create-wizard">
        <wz:flow xmlns:wz="http://www.hybris.com/cockpitng/config/wizard-config"
                 id="AdyenChargebeePlanMappingWizard" title="create.title(ctx.TYPE_CODE)">
            <wz:step id="step1" label="hmc.adyen.planMapping">
                <wz:content id="step1.content" merge-mode="replace">
                    <wz:property qualifier="newObject.productCode"/>
                    <wz:property qualifier="newObject.baseStore"/>
                    <wz:property qualifier="newObject.itemPriceId"/>
                    <wz:property qualifier="newObject.priceId"/>
                </wz:content>
            </wz:step>
        </wz:flow>
    </context>

</config>
