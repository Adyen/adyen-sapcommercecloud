<!--
 Copyright (c) 2026 Adyen B.V. - MIT license.

 adyenv6chargebeeconnector - Chargebee adapter of the SubscriptionBillingConnector SPI.
 First external adapter (ADR-001 Option A: Adyen keeps processing recurring payments;
 Chargebee only orchestrates billing). Implements the port defined in adyensubscriptionconnector.
-->
<extensioninfo xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="extensioninfo.xsd">

    <extension abstractclassprefix="Generated" classprefix="Adyenv6chargebeeconnector" jaloLogicFree="true"
               managername="Adyenv6chargebeeconnectorManager"
               managersuperclass="de.hybris.platform.jalo.extension.Extension"
               name="adyenv6chargebeeconnector" usemaven="false">

        <!-- The SPI + normalized model come from the core; httpclient5 + jackson come
             transitively from adyenv6core (usemaven=false: no own maven deps needed). -->
        <requires-extension name="adyensubscriptionconnector"/>
        <requires-extension name="adyenv6core"/>

        <coremodule generated="true"
                    manager="com.adyen.commerce.connector.chargebee.jalo.Adyenv6chargebeeconnectorManager"
                    packageroot="com.adyen.commerce.connector.chargebee"/>
    </extension>

</extensioninfo>
