	<!-- ===================================================================================
	     Per-subscription outcome of one delivery.

	     An invoice can name several subscriptions, so a delivery fans out and each subscription
	     succeeds or fails on its own. The delivery's own row says only whether the fan-out as a
	     whole was handled; this is where an operator sees which subscription was actually updated.

	     lastError sits next to processingStatus in every view here, and that is not decoration.
	     SKIPPED_UNKNOWN_SUBSCRIPTION means two different things and only lastError separates them:
	     empty, the delivery was not about a subscription of ours and there is nothing to do; set,
	     we did expect a local reference, waited out the whole retry budget and gave up - and that
	     one needs somebody, because the reference it waited for was never created.
	     ==================================================================================== -->
	<context merge-by="type" parent="GenericItem" type="BillingWebhookEventApplication" component="listview">
		<lv:list-view>
			<lv:column qualifier="processingStatus"/>
			<lv:column qualifier="lastError"/>
			<lv:column qualifier="externalSubscriptionId"/>
			<lv:column qualifier="subscriptionRef"/>
			<lv:column qualifier="attemptCount"/>
			<lv:column qualifier="reconciledAt"/>
			<lv:column qualifier="event"/>
		</lv:list-view>
	</context>

	<context merge-by="type" parent="GenericItem" type="BillingWebhookEventApplication" component="advanced-search">
		<as:advanced-search>
			<as:field-list>
				<as:field name="processingStatus" selected="true"/>
				<as:field name="externalSubscriptionId" selected="true"/>
				<!-- Selected by default because it is the field that turns an ambiguous skip into a decision:
				     searching it non-empty is how an operator finds the ones that need them. -->
				<as:field name="lastError" selected="true"/>
				<as:field name="subscriptionRef"/>
				<as:field name="reconciledAt"/>
				<as:field name="attemptCount"/>
			</as:field-list>
		</as:advanced-search>
	</context>

	<context merge-by="type" type="BillingWebhookEventApplication" component="editor-area">
