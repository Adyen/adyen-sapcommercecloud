<config xmlns="http://www.hybris.com/cockpit/config"
		xmlns:na="http://www.hybris.com/cockpitng/config/notifications"
		xmlns:lv="http://www.hybris.com/cockpitng/component/listView"
		xmlns:as="http://www.hybris.com/cockpitng/config/advancedsearch">

	<!-- adyenv6backoffice UI configuration should be provided here -->

	<!--<context component="component-code" module="adyenv6backoffice">-->
	<!--Please check documentation for code snippets for specific components-->
	<!--</context>-->

	<context component="cseditorareaactions" type="Order" merge-by="type">
		<y:actions xmlns:y="http://www.hybris.com/cockpit/config/hybris">
			<y:group qualifier="common" merge-mode="merge">
				<y:label>actiongroup.common</y:label>
				<y:action action-id="com.adyen.v6.backoffice.widgets.actions.adyencancelorderaction"
						  property="currentObject" merge-mode="append" position="1"/>
			</y:group>
		</y:actions>
	</context>

	<context merge-by="module" type="Order" component="editorareaactions">
		<y:actions xmlns:y="http://www.hybris.com/cockpit/config/hybris">
			<y:group qualifier="common">
				<y:label>actiongroup.common</y:label>
				<y:action action-id="com.adyen.v6.backoffice.widgets.actions.adyencaptureorderaction" property="currentObject"
						  output-property="currentObject" />
			</y:group>
		</y:actions>
	</context>

	<context component="notification-area" source="adyen-capture-message-source" merge-by="source">
		<na:notification-area>
			<na:notifications eventType="General" level="SUCCESS">
				<na:message>adyen.order.capture.succeed</na:message>
				<na:references linksEnabled="false"/>
			</na:notifications>
			<na:notifications eventType="General" level="FAILURE">
				<na:message>adyen.order.capture.failure</na:message>
				<na:references linksEnabled="false"/>
			</na:notifications>
		</na:notification-area>
	</context>


	<context merge-by="type" type="BaseStore" component="editor-area">
		<editorArea:editorArea xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea">
			<editorArea:tab name="hmc.adyen">
				<editorArea:section name="hmc.adyen.account">
					<editorArea:attribute qualifier="adyenMerchantConfig"/>
					<editorArea:attribute qualifier="adyenMerchantAccount"/>
					<editorArea:attribute qualifier="adyenImmediateCapture"/>
					<editorArea:attribute qualifier="adyenRecurringContractMode"/>
					<editorArea:attribute qualifier="adyenTestMode"/>
					<editorArea:attribute qualifier="adyenGuestUserTokenization"/>
					<editorArea:attribute qualifier="adyenAllowedCards"/>
					<editorArea:attribute qualifier="adyenRegion"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.api">
					<editorArea:attribute qualifier="adyenAPIEndpointPrefix"/>
					<editorArea:attribute qualifier="adyenAPIKey" editor="com.hybris.cockpitng.editor.defaultpassword"/>
					<editorArea:attribute qualifier="adyenClientKey" editor="com.hybris.cockpitng.editor.defaultpassword"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.notifications">
					<editorArea:attribute qualifier="adyenNotificationUsername"/>
					<editorArea:attribute qualifier="adyenNotificationPassword" editor="com.hybris.cockpitng.editor.defaultpassword"/>
					<editorArea:attribute qualifier="adyenNotificationHMACKey"/>
					<editorArea:attribute qualifier="adyenAllowEmptyHMACKey"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.expressPayments">
					<editorArea:attribute qualifier="expressPaymentConfig" />
				</editorArea:section>
				<editorArea:section name="hmc.adyen.clicktopay">
					<editorArea:attribute qualifier="clickToPayLocale" />
				</editorArea:section>
				<editorArea:section name="hmc.adyen.amazonpay">
					<editorArea:attribute qualifier="amazonpayPublicKey"/>
					<editorArea:attribute qualifier="amazonpayEnvironment"/>
					<editorArea:attribute qualifier="amazonpayRegion"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.advanced">
						<editorArea:attribute qualifier="adyenBoleto"/>
						<editorArea:attribute qualifier="adyenPaypalMerchantId"/>
						<editorArea:attribute qualifier="l2L3ESDEnabled"/>
						<editorArea:attribute qualifier="adyenSkipCvcForOneClick"/>
						<editorArea:attribute qualifier="additionalPaymentRetry" />
					</editorArea:section>
				<!-- activeBillingPlatform is declared by adyensubscriptionconnector, which adyenv6backoffice
				     does not require. With that extension disabled DefaultEditorAreaSectionRenderer logs one
				     ERROR and skips the field, leaving this section rendered but empty; the rest of the
				     editor area is unaffected. -->
				<editorArea:section name="hmc.adyen.subscriptionPlatform">
					<editorArea:attribute qualifier="activeBillingPlatform"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.recurlyConfig">
					<editorArea:attribute qualifier="recurlyConfig"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.chargebeeConfig">
					<editorArea:attribute qualifier="chargebeeConfig"/>
				</editorArea:section>
				<!-- No Zuora section until a Zuora connector exists. ZuoraConfig has no attributes of
				     its own and nothing reads it, so offering it here only lets an operator configure a
				     platform whose first activation throws ConnectorNotConfiguredException. Restore this
				     section together with the connector. -->
				<editorArea:section name="hmc.adyen.installments">
					<editorArea:attribute qualifier="adyenInstallmentConfigs"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.dataCollection">
					<editorArea:attribute qualifier="dataCollectionEnabled"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.configuration">
					<editorArea:attribute qualifier="adyenPaymentMethodNameConfig"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<context merge-by="type" type="AdyenInstallmentConfig" component="editor-area">
		<editorArea:editorArea xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea">
			<editorArea:tab name="hmc.adyen.installments.config">
				<editorArea:section name="hmc.adyen.installments.config.general">
					<editorArea:attribute qualifier="country"/>
					<editorArea:attribute qualifier="enabled" editor="com.hybris.cockpitng.editor.defaultboolean"/>
					<editorArea:attribute qualifier="supportedCurrencies"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.installments.config.options">
					<editorArea:attribute qualifier="installmentOptions" editor="com.hybris.cockpitng.editor.defaulttext"/>
					<editorArea:attribute qualifier="installmentPlans" editor="com.hybris.cockpitng.editor.defaulttext"/>
					<editorArea:attribute qualifier="showInstallmentAmounts" editor="com.hybris.cockpitng.editor.defaulttext"/>
					<editorArea:attribute qualifier="showInstallmentPlans" editor="com.hybris.cockpitng.editor.defaulttext"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<context merge-by="type" type="CsTicket" component="editor-area">
		<editorArea:editorArea xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea">
			<editorArea:tab name="hmc.adyen">
				<editorArea:section name="hmc.adyen.details">
					<editorArea:attribute qualifier="pspReference"/>
					<editorArea:attribute qualifier="originalReference"/>
					<editorArea:attribute qualifier="amount"/>
					<editorArea:attribute qualifier="currency"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<context type="Order" component="advanced-search" merge-by="type">
		<as:advanced-search>
			<as:field-list>
				<as:field name="adyenRiskScore"/>
			</as:field-list>
		</as:advanced-search>
	</context>

	<context merge-by="type" type="Order" component="listview">
		<lv:list-view>
			<lv:column qualifier="adyenRiskScore"/>
		</lv:list-view>
	</context>

	<!-- ===================================================================================
	     Subscription billing: the operator's view of what the connector stack is doing.

	     These types belong to adyensubscriptionconnector, which this extension does not
	     require — the same arrangement, and the same trade-off, as the activeBillingPlatform
	     field above. With that extension disabled the type nodes below resolve to nothing and
	     Backoffice logs about them; the alternative was a whole extra backoffice extension
	     for three list views, or leaving the dead-letter queue with no UI at all, which is
	     what this is here to fix.

	     BillingActivationAttempt comes first on purpose. It is the one an operator is woken
	     up for: a row in DEAD_LETTER there means a shopper paid and has no subscription.
	     ==================================================================================== -->
	<context merge-by="module" parent="auto" component="explorer-tree">
		<explorer-tree:explorer-tree xmlns:explorer-tree="http://www.hybris.com/cockpitng/config/explorertree">
			<explorer-tree:navigation-node id="hmc_treenode_system" merge-mode="append">
				<explorer-tree:navigation-node id="adyen.subscriptionBilling">
					<explorer-tree:type-node code="BillingActivationAttempt" id="adyen.billingActivationAttempt"/>
					<explorer-tree:type-node code="BillingWebhookEvent" id="adyen.billingWebhookEvent"/>
					<explorer-tree:type-node code="BillingSubscriptionRef" id="adyen.billingSubscriptionRef"/>
				</explorer-tree:navigation-node>
			</explorer-tree:navigation-node>
		</explorer-tree:explorer-tree>
	</context>

	<context merge-by="type" parent="GenericItem" type="BillingActivationAttempt" component="listview">
		<lv:list-view>
			<!-- Status first, then how hard we tried and when we stop trying: the three columns that
			     answer "is anything wrong and is anything still going to happen about it". -->
			<lv:column qualifier="status"/>
			<lv:column qualifier="attemptCount"/>
			<lv:column qualifier="nextAttemptAt"/>
			<lv:column qualifier="deadLetteredAt"/>
			<lv:column qualifier="order"/>
			<lv:column qualifier="platform"/>
			<lv:column qualifier="productCode"/>
			<lv:column qualifier="subscriptionRef"/>
			<lv:column qualifier="lastError"/>
		</lv:list-view>
	</context>

	<context merge-by="type" parent="GenericItem" type="BillingActivationAttempt" component="advanced-search">
		<as:advanced-search>
			<as:field-list>
				<as:field name="status" selected="true"/>
				<as:field name="platform" selected="true"/>
				<as:field name="deadLetteredAt" selected="true"/>
				<as:field name="attemptCount"/>
				<as:field name="nextAttemptAt"/>
				<as:field name="idempotencyKey"/>
				<as:field name="productCode"/>
			</as:field-list>
		</as:advanced-search>
	</context>

	<context merge-by="type" type="BillingActivationAttempt" component="editor-area">
		<editorArea:editorArea xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea">
			<editorArea:tab name="hmc.adyen.subscriptionBilling.attempt">
				<editorArea:section name="hmc.adyen.subscriptionBilling.outcome">
					<editorArea:attribute qualifier="status"/>
					<editorArea:attribute qualifier="subscriptionRef"/>
					<editorArea:attribute qualifier="lastError"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.subscriptionBilling.request">
					<editorArea:attribute qualifier="order"/>
					<editorArea:attribute qualifier="platform"/>
					<editorArea:attribute qualifier="productCode"/>
					<editorArea:attribute qualifier="idempotencyKey"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.subscriptionBilling.retry">
					<editorArea:attribute qualifier="attemptCount"/>
					<editorArea:attribute qualifier="firstAttemptAt"/>
					<editorArea:attribute qualifier="lastAttemptAt"/>
					<editorArea:attribute qualifier="nextAttemptAt"/>
					<editorArea:attribute qualifier="deadLetteredAt"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<context merge-by="type" parent="GenericItem" type="BillingWebhookEvent" component="listview">
		<lv:list-view>
			<lv:column qualifier="processingStatus"/>
			<lv:column qualifier="attemptCount"/>
			<lv:column qualifier="deadLetteredAt"/>
			<lv:column qualifier="platform"/>
			<lv:column qualifier="eventType"/>
			<lv:column qualifier="eventId"/>
			<lv:column qualifier="externalSubscriptionId"/>
			<lv:column qualifier="occurredAt"/>
			<lv:column qualifier="receivedAt"/>
			<lv:column qualifier="lastError"/>
		</lv:list-view>
	</context>

	<context merge-by="type" parent="GenericItem" type="BillingWebhookEvent" component="advanced-search">
		<as:advanced-search>
			<as:field-list>
				<as:field name="processingStatus" selected="true"/>
				<as:field name="platform" selected="true"/>
				<as:field name="deadLetteredAt" selected="true"/>
				<as:field name="eventType"/>
				<as:field name="eventId"/>
				<as:field name="externalSubscriptionId"/>
				<as:field name="receivedAt"/>
			</as:field-list>
		</as:advanced-search>
	</context>

	<context merge-by="type" type="BillingWebhookEvent" component="editor-area">
		<editorArea:editorArea xmlns:editorArea="http://www.hybris.com/cockpitng/component/editorArea">
			<editorArea:tab name="hmc.adyen.subscriptionBilling.event">
				<editorArea:section name="hmc.adyen.subscriptionBilling.outcome">
					<editorArea:attribute qualifier="processingStatus"/>
					<editorArea:attribute qualifier="attemptCount"/>
					<editorArea:attribute qualifier="deadLetteredAt"/>
					<editorArea:attribute qualifier="subscriptionRef"/>
					<editorArea:attribute qualifier="lastError"/>
				</editorArea:section>
				<editorArea:section name="hmc.adyen.subscriptionBilling.delivery">
					<editorArea:attribute qualifier="platform"/>
					<editorArea:attribute qualifier="eventId"/>
					<editorArea:attribute qualifier="eventType"/>
					<editorArea:attribute qualifier="externalSubscriptionId"/>
					<editorArea:attribute qualifier="occurredAt"/>
					<editorArea:attribute qualifier="receivedAt"/>
				</editorArea:section>
			</editorArea:tab>
		</editorArea:editorArea>
	</context>

	<context merge-by="type" parent="GenericItem" type="BillingSubscriptionRef" component="listview">
		<lv:list-view>
			<lv:column qualifier="status"/>
			<lv:column qualifier="platform"/>
			<lv:column qualifier="externalSubscriptionId"/>
			<lv:column qualifier="customer"/>
			<lv:column qualifier="order"/>
			<lv:column qualifier="planCode"/>
			<lv:column qualifier="currentPeriodEnd"/>
			<lv:column qualifier="lastSyncedAt"/>
		</lv:list-view>
	</context>

</config>
