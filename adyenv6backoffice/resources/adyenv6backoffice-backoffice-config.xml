	<!-- Create wizards for the subscription platform configurations.

	     These are created from the base store editor above, through the recurlyConfig/chargebeeConfig
	     reference. Without an explicit wizard Backoffice offers only the attributes the type system marks
	     mandatory, which silently drops adyenGatewayMerchantAccount from the form: it is optional at type
	     level on purpose, so that ZuoraConfig can inherit it and so that an update system does not make
	     pre-existing rows unsaveable. The connectors, though, refuse to import a token without it - fail
	     closed, and only once the shopper has already been charged. Listing it here is what puts it in
	     front of the operator at the one moment they are filling the form.

	     The encrypted fields get the password editor for the same reason the base store's API key does:
	     nobody should have to type a full-access key into a field that shows it in the clear. -->
	<context merge-by="type" type="ChargebeeConfig" component="create-wizard">
		<wz:flow xmlns:wz="http://www.hybris.com/cockpitng/config/wizard-config"
				 id="AdyenChargebeeConfigWizard" title="create.title(ctx.TYPE_CODE)">
			<wz:step id="step1" label="hmc.adyen.subscriptionConfig.step">
				<wz:content id="step1.content" merge-mode="replace">
					<wz:property qualifier="newObject.subscriptionSiteId"/>
					<wz:property qualifier="newObject.subscriptionApiKey"
								 editor="com.hybris.cockpitng.editor.defaultpassword"/>
					<wz:property qualifier="newObject.subscriptionGatewayAccountId"/>
					<wz:property qualifier="newObject.adyenGatewayMerchantAccount"/>
					<wz:property qualifier="newObject.chargebeeWebhookUsername"/>
					<wz:property qualifier="newObject.chargebeeWebhookPassword"
								 editor="com.hybris.cockpitng.editor.defaultpassword"/>
				</wz:content>
			</wz:step>
		</wz:flow>
	</context>

	<context merge-by="type" type="RecurlyConfig" component="create-wizard">
		<wz:flow xmlns:wz="http://www.hybris.com/cockpitng/config/wizard-config"
