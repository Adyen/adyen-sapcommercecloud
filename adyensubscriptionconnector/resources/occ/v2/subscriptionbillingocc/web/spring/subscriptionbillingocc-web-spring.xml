<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config/>
    <context:component-scan base-package="com.adyen.commerce.connector.occ.controllers"/>

    <!--
      The webhook endpoint is base-site-independent: its first path segment is "subscription-billing",
      not a base site. OCC's baseSiteMatchingFilter otherwise treats the first segment as {baseSiteId}
      and rejects the request with "Base site subscription-billing doesn't exist". We override that
      filter to add "subscription-billing" to the negative-lookahead exclusion list (alongside the
      platform's own swagger/api-docs/csrf/webjars).

      This file is imported AFTER filter-config-v2-spring.xml in the same web application context, so
      this definition overrides the platform default.

      WARNING for projects that add their own base-site-independent OCC prefix: this bean id is a
      single, shared slot. A later Spring import REPLACES an earlier bean definition with the same id
      outright — there is no merging of the regexp. If your extension overrides
      defaultBaseSiteMatchingFilter as well, whichever of the two files the classpath scan happens to
      import last wins in full, and the other extension's prefix is silently dropped. Import order
      over "classpath*:/occ/v2/*occ/web/spring/*-web-spring.xml" is not guaranteed, so do not rely on
      it: repeat the COMPLETE exclusion list (including "subscription-billing") in your own override.
    -->
    <bean id="defaultBaseSiteMatchingFilter"
          class="de.hybris.platform.commercewebservices.core.v2.filter.BaseSiteMatchingFilter">
        <property name="regexp"
                  value="^/(?!(swagger)|(.*api-docs)|(csrf)|(webjars)|(subscription-billing))([^/]+)"/>
        <property name="baseSiteService" ref="baseSiteService"/>
    </bean>

</beans>
