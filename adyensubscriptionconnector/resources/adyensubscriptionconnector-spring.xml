<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:util="http://www.springframework.org/schema/util"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/util
           http://www.springframework.org/schema/util/spring-util.xsd">

    <!-- ============================================================= -->
    <!-- Connector registry                                            -->
    <!-- The registry auto-discovers every SubscriptionBillingConnector -->
    <!-- bean from the application context (ApplicationContextAware), so -->
    <!-- an adapter extension only needs to declare its connector bean.  -->
    <!-- ============================================================= -->
    <alias name="defaultSubscriptionBillingConnectorRegistry" alias="subscriptionBillingConnectorRegistry"/>
    <bean id="defaultSubscriptionBillingConnectorRegistry"
          class="com.adyen.commerce.connector.registry.impl.DefaultSubscriptionBillingConnectorRegistry"/>

    <!-- ============================================================= -->
    <!-- Startup / pre-activation validation                          -->
    <!-- connector's Adyen merchant account must equal the store's.    -->
    <!-- adyenMerchantStrategy is provided by adyenv6core.             -->
    <!-- ============================================================= -->
    <alias name="defaultConnectorMerchantAccountValidator" alias="connectorMerchantAccountValidator"/>
    <bean id="defaultConnectorMerchantAccountValidator"
          class="com.adyen.commerce.connector.validation.impl.DefaultConnectorMerchantAccountValidator">
        <property name="adyenMerchantAccountStrategy" ref="adyenMerchantStrategy"/>
    </bean>

    <!-- ============================================================= -->
    <!-- AdyenTokenHandle factory                                      -->
    <!-- builds the uniform token contract from the existing Adyen flow -->
    <!-- ============================================================= -->
    <alias name="defaultAdyenTokenHandleFactory" alias="adyenTokenHandleFactory"/>
    <bean id="defaultAdyenTokenHandleFactory"
          class="com.adyen.commerce.connector.token.impl.DefaultAdyenTokenHandleFactory">
        <property name="adyenMerchantAccountStrategy" ref="adyenMerchantStrategy"/>
    </bean>

    <!-- ============================================================= -->
    <!-- "Is this a subscription product?"                             -->
    <!-- Deliberately ONE bean, injected into both the payment          -->
    <!-- decorator (before the shopper is charged) and the order        -->
    <!-- activator (after). Two implementations of the same rule would  -->
    <!-- agree only until somebody touched one of them, and disagreeing -->
    <!-- means either a token nothing uses or a charge nothing can      -->
    <!-- activate. Override this bean to change the rule for both.      -->
    <!-- ============================================================= -->
    <alias name="defaultSubscriptionProductRule" alias="subscriptionProductRule"/>
    <bean id="defaultSubscriptionProductRule"
          class="com.adyen.commerce.connector.product.impl.DefaultSubscriptionProductRule"/>

    <!-- Runs while the Adyen /payments request is still being built, before the shopper can be
         charged. It both forces tokenization for mapped subscription products and rejects payment
         methods that the connector cannot safely reuse for renewals. -->
    <bean id="subscriptionPaymentRequestDecorator"
          class="com.adyen.commerce.connector.payment.SubscriptionPaymentRequestDecorator">
        <property name="cartService" ref="cartService"/>
        <property name="connectorRegistry" ref="subscriptionBillingConnectorRegistry"/>
        <property name="subscriptionProductRule" ref="subscriptionProductRule"/>
    </bean>

    <!-- ============================================================= -->
    <!-- Retry policy                                                  -->
    <!-- the one answer to "try again, and when?", shared by the        -->
    <!-- activation path (which owns its retries) and the webhook path  -->
    <!-- (whose retries belong to the platform)                        -->
    <!-- ============================================================= -->
    <alias name="defaultBillingRetryPolicy" alias="billingRetryPolicy"/>
    <bean id="defaultBillingRetryPolicy"
          class="com.adyen.commerce.connector.retry.impl.DefaultBillingRetryPolicy">
        <property name="maxAttempts" value="${adyen.subscription.retry.maxAttempts}"/>
        <property name="initialBackoffSeconds" value="${adyen.subscription.retry.initialBackoffSeconds}"/>
        <property name="backoffMultiplier" value="${adyen.subscription.retry.backoffMultiplier}"/>
        <property name="maxBackoffSeconds" value="${adyen.subscription.retry.maxBackoffSeconds}"/>
    </bean>

    <!-- ============================================================= -->
    <!-- Activation attempt journal                                    -->
    <!-- one row per (order, platform): which idempotency key was sent  -->
    <!-- and what became of it, including the failures                 -->
    <!-- ============================================================= -->
    <alias name="defaultBillingActivationAttemptService" alias="billingActivationAttemptService"/>
    <bean id="defaultBillingActivationAttemptService"
          class="com.adyen.commerce.connector.activation.impl.DefaultBillingActivationAttemptService">
        <property name="modelService" ref="modelService"/>
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="retryPolicy" ref="billingRetryPolicy"/>
    </bean>

    <!-- ============================================================= -->
    <!-- Orchestration service (the single entry point / facade)       -->
    <!-- ============================================================= -->
    <alias name="defaultSubscriptionBillingService" alias="subscriptionBillingService"/>
    <bean id="defaultSubscriptionBillingService"
          class="com.adyen.commerce.connector.service.impl.DefaultSubscriptionBillingService">
        <property name="connectorRegistry" ref="subscriptionBillingConnectorRegistry"/>
        <property name="merchantAccountValidator" ref="connectorMerchantAccountValidator"/>
        <property name="tokenHandleFactory" ref="adyenTokenHandleFactory"/>
        <property name="modelService" ref="modelService"/>
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="eventService" ref="eventService"/>
        <property name="reconciliationService"
                  ref="subscriptionReconciliationService"/>
    </bean>

    <alias name="defaultSubscriptionReconciliationService" alias="subscriptionReconciliationService"/>
    <bean id="defaultSubscriptionReconciliationService"
          class="com.adyen.commerce.connector.reconciliation.impl.DefaultSubscriptionReconciliationService">
        <property name="connectorRegistry" ref="subscriptionBillingConnectorRegistry"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <!-- ============================================================= -->
    <!-- Reconciliation sweep                                          -->
    <!-- created and triggered by essentialdata impex on system update -->
    <!-- ============================================================= -->
    <bean id="subscriptionReconciliationJob"
          class="com.adyen.commerce.connector.job.SubscriptionReconciliationJob"
          parent="abstractJobPerformable">
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="reconciliationService" ref="subscriptionReconciliationService"/>
        <property name="configurationService" ref="configurationService"/>
        <property name="sessionService" ref="sessionService"/>
        <property name="baseSiteService" ref="baseSiteService"/>
    </bean>

    <!-- Cron jobs have no storefront context. This selector reads the exact order store from a local
         reconciliation session and otherwise yields to SAP's ordinary site-based selector. -->
    <bean id="subscriptionBaseStoreSelectorStrategy"
          class="com.adyen.commerce.connector.context.SubscriptionBaseStoreSelectorStrategy">
        <property name="sessionService" ref="sessionService"/>
    </bean>
    <bean id="subscriptionBaseStoreSelectorStrategyMergeDirective"
          depends-on="defaultBaseStoreService" parent="listMergeDirective">
        <property name="add" ref="subscriptionBaseStoreSelectorStrategy"/>
        <property name="fieldName" value="baseStoreSelectorStrategies"/>
        <property name="beforeClasses">
            <list value-type="java.lang.Class">
                <value>de.hybris.platform.basecommerce.strategies.impl.DefaultBaseStoreSelectorStrategy</value>
            </list>
        </property>
    </bean>

    <!-- ============================================================= -->
    <!-- Webhook dispatcher                                            -->
    <!-- normalizes inbound platform webhooks and reconciles SAP state -->
    <!-- ============================================================= -->
    <alias name="defaultSubscriptionBillingWebhookDispatcher" alias="subscriptionBillingWebhookDispatcher"/>
    <bean id="defaultSubscriptionBillingWebhookDispatcher"
          class="com.adyen.commerce.connector.webhook.impl.DefaultSubscriptionBillingWebhookDispatcher">
        <property name="connectorRegistry" ref="subscriptionBillingConnectorRegistry"/>
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="modelService" ref="modelService"/>
        <property name="retryPolicy" ref="billingRetryPolicy"/>
        <property name="reconciliationService" ref="subscriptionReconciliationService"/>
    </bean>

    <!-- ============================================================= -->
    <!-- Order activation                                              -->
    <!-- decides whether a placed order becomes a subscription;         -->
    <!-- deliberately independent of what triggers it                  -->
    <!-- ============================================================= -->
    <alias name="defaultSubscriptionOrderActivator" alias="subscriptionOrderActivator"/>
    <bean id="defaultSubscriptionOrderActivator"
          class="com.adyen.commerce.connector.activation.impl.DefaultSubscriptionOrderActivator">
        <property name="subscriptionBillingService" ref="subscriptionBillingService"/>
        <property name="connectorRegistry" ref="subscriptionBillingConnectorRegistry"/>
        <!-- The same instance the payment decorator uses; see the rule bean above. -->
        <property name="subscriptionProductRule" ref="subscriptionProductRule"/>
        <property name="attemptService" ref="billingActivationAttemptService"/>
        <!-- The connectors' config services read credentials from the *current* base store, and neither an
             Adyen notification thread nor a cron thread has one. These three are how the activator puts the
             order's own store there before any connector is touched. -->
        <property name="sessionService" ref="sessionService"/>
        <property name="baseSiteService" ref="baseSiteService"/>
        <property name="baseStoreService" ref="baseStoreService"/>
    </bean>

    <!-- ============================================================= -->
    <!-- Activation retry job                                          -->
    <!-- created and triggered by essentialdata impex on system update -->
    <!-- ============================================================= -->
    <bean id="subscriptionActivationRetryJob"
          class="com.adyen.commerce.connector.activation.job.SubscriptionActivationRetryJob"
          parent="abstractJobPerformable">
        <property name="attemptService" ref="billingActivationAttemptService"/>
        <property name="subscriptionOrderActivator" ref="subscriptionOrderActivator"/>
        <property name="batchSize" value="${adyen.subscription.retry.job.batchSize}"/>
        <property name="stalePendingAfterSeconds" value="${adyen.subscription.retry.job.stalePendingAfterSeconds}"/>
    </bean>

    <!-- ============================================================= -->
    <!-- Essential data                                                -->
    <!-- ============================================================= -->
    <bean id="adyensubscriptionconnectorSystemSetup"
          class="com.adyen.commerce.connector.setup.AdyensubscriptionconnectorSystemSetup"
          parent="abstractCoreSystemSetup"/>

    <!-- ============================================================= -->
    <!-- Activation trigger                                            -->
    <!-- fires on Adyen's AUTHORISATION notification, which is the      -->
    <!-- first moment the token is on the order AND the payment is      -->
    <!-- confirmed                                                     -->
    <!-- ============================================================= -->
    <bean id="subscriptionActivationAuthorisationEventListener"
          class="com.adyen.commerce.connector.listener.SubscriptionActivationAuthorisationEventListener"
          parent="abstractEventListener">
        <property name="subscriptionOrderActivator" ref="subscriptionOrderActivator"/>
        <property name="orderRepository" ref="adyenOrderRepository"/>
    </bean>

    <!-- A 3DS/redirect order is placed before its final token metadata exists, so the ordinary
         place-order hook cannot activate it. Re-enter the same idempotent flow when adyenv6core
         announces that authorization and PaymentInfo persistence have completed. -->
    <bean id="adyenPaymentAuthorizedSubscriptionListener"
          class="com.adyen.commerce.connector.listener.AdyenPaymentAuthorizedEventListener"
          parent="abstractEventListener">
        <property name="subscriptionOrderActivator" ref="subscriptionOrderActivator"/>
    </bean>

</beans>
