<!-- 
  WARNING: This is the Spring WEB configuration file. If you want to replace
  items or managers you have to do this from the extensions core configuration 
  file (adyenrecurlyconnector/resources/adyenrecurlyconnector-spring.xml) 
  -->

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           https://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           https://www.springframework.org/schema/context/spring-context.xsd">

    <import resource="adyenrecurlyconnector-spring-security-config.xml"/>

    <context:annotation-config/>

	<!-- Spring managed FilterChain for hybris Filter stack -->
	<bean id="adyenrecurlyconnectorPlatformFilterChain" class="de.hybris.platform.servicelayer.web.PlatformFilterChain">
		<constructor-arg>
			<list>
				<ref bean="log4jFilter"/>
				<!--
				  restSessionFilter, not sessionFilter. The only endpoint here is an unauthenticated
				  webhook: sessionFilter would create an HttpSession plus a JaloSession for every request
				  and leave them to expire on their own, so anyone able to POST to this URL could pin
				  session pairs in memory for the whole session-timeout window without presenting a single
				  credential. restSessionFilter opens a jalo session per request and closes it again, and
				  SessionHidingFilter in web.xml stops the HttpSession being created at all. Same choice as
				  adyenv6notificationv2, which faces the same exposure.
				  If this webapp ever needs to track user sessions, swap the three of them back together.
				-->
				<ref bean="restSessionFilter"/>
                <ref bean="adyenrecurlyconnectorMediaFilter"/>
			</list>
		</constructor-arg>
	</bean>

	<bean id="restSessionFilter" class="de.hybris.platform.webservicescommons.filter.RestSessionFilter">
		<property name="sessionService" ref="sessionService"/>
	</bean>

    <!-- This filter is responsible for all media and secure-media handling -->
    <bean id="adyenrecurlyconnectorMediaFilter" class="de.hybris.platform.servicelayer.web.WebAppMediaFilter">
        <property name="mediaPermissionService" ref="mediaPermissionService"/>
        <property name="modelService" ref="modelService"/>
        <property name="userService" ref="userService"/>
        <property name="mediaService" ref="mediaService"/>
        <!-- Change this it to 'true' if you want webApp contextPath to be added automatically to the URLs by the filter -->
        <property name="addContextPath" value="false" />
        <!--  secure media resource path prefix - __secure__ is default, but you may overwrite it -->
        <!-- <property name="secureMediasResourcePathPrefix" value="__secure__"/> -->
    </bean>

	<!--
	 WARNING: 
	 Do NOT override hybris managers or items within the web module!
	 Use always the core spring configuration file (adyenrecurlyconnector-spring.xml) in
	 the extensions resources/ directory.
	 -->
</beans>
