<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <alias name="defaultRecurlyConfigService" alias="recurlyConfigService"/>
    <bean id="defaultRecurlyConfigService"
          class="com.adyen.commerce.connector.recurly.config.impl.DefaultRecurlyConfigService">
        <property name="configurationService" ref="configurationService"/>
        <property name="baseStoreService" ref="baseStoreService"/>
    </bean>

    <alias name="defaultRecurlyHttpClient" alias="recurlyHttpClient"/>
    <bean id="defaultRecurlyHttpClient"
          class="com.adyen.commerce.connector.recurly.http.impl.DefaultRecurlyHttpClient">
        <property name="configService" ref="recurlyConfigService"/>
    </bean>

    <alias name="defaultRecurlyApiClient" alias="recurlyApiClient"/>
    <bean id="defaultRecurlyApiClient"
          class="com.adyen.commerce.connector.recurly.client.impl.DefaultRecurlyApiClient">
        <property name="httpClient" ref="recurlyHttpClient"/>
        <property name="configService" ref="recurlyConfigService"/>
    </bean>

    <alias name="defaultRecurlyPlanResolver" alias="recurlyPlanResolver"/>
    <bean id="defaultRecurlyPlanResolver"
          class="com.adyen.commerce.connector.recurly.plan.impl.DefaultRecurlyPlanResolver">
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
    </bean>

    <alias name="defaultRecurlyWebhookParser" alias="recurlyWebhookParser"/>
    <bean id="defaultRecurlyWebhookParser"
          class="com.adyen.commerce.connector.recurly.webhook.DefaultRecurlyWebhookParser">
        <property name="configService" ref="recurlyConfigService"/>
    </bean>

    <!-- No Recurly webhook dispatcher: the single dispatcher in adyensubscriptionconnector handles inbound
         webhooks through this adapter. -->
    <bean id="recurlySubscriptionBillingConnector"
          class="com.adyen.commerce.connector.recurly.RecurlySubscriptionBillingConnector">
        <property name="apiClient" ref="recurlyApiClient"/>
        <property name="configService" ref="recurlyConfigService"/>
        <property name="planResolver" ref="recurlyPlanResolver"/>
        <property name="webhookParser" ref="recurlyWebhookParser"/>
    </bean>

    <!-- The registry discovers SubscriptionBillingConnector beans by type; do not inject a list into it. -->

</beans>
