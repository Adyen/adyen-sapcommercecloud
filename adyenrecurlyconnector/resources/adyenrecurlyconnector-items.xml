 Copyright (c) 2026 Adyen B.V. - MIT license.

 Recurly-specific type-system: the RECURLY billing platform value, the base store's
 Recurly configuration, and an admin-editable mapping from a SAP subscription product
 code to a Recurly plan code (resolvePlan). The vendor-neutral BillingPlatform enum,
 AdyenSubscriptionConfig and the reference types live in adyensubscriptionconnector.
-->
<items xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="items.xsd">

    <enumtypes>
        <enumtype code="BillingPlatform" autocreate="false" generate="true" dynamic="true">
            <value code="RECURLY"/>
        </enumtype>
    </enumtypes>

    <itemtypes>
        <itemtype code="RecurlyConfig" autocreate="true" generate="true" extends="AdyenSubscriptionConfig">
            <attributes>
                <attribute qualifier="recurlyWebhookSigningKey" type="java.lang.String">
                    <description>Recurly Webhook Signing Key</description>
                    <persistence type="property">
                        <columntype>
                            <value>varchar(1024)</value>
                        </columntype>
                    </persistence>
                    <modifiers encrypted="true" optional="false"/>
                </attribute>
                <attribute qualifier="walletEnabled" type="java.lang.boolean">
                    <description>Wallet Enabled</description>
                    <modifiers optional="false"/>
                    <persistence type="property"/>
                    <defaultvalue>Boolean.FALSE</defaultvalue>
                </attribute>
                <attribute qualifier="externalNtidFeatureEnabled" type="java.lang.boolean">
                    <description>External Ntid Feature Enabled</description>
                    <modifiers optional="false"/>
                    <persistence type="property"/>
                    <defaultvalue>Boolean.FALSE</defaultvalue>
                </attribute>
                <attribute qualifier="paymentMethodChangeEnabled" type="java.lang.boolean">
                    <description>Let shoppers repoint a subscription at another payment method the Recurly
                        account already holds. Requires Wallet, and is deliberately SEPARATE from it: Wallet
                        also switches the token-import path used when a subscription is created, so a site
                        that turns Wallet on for that reason must not silently acquire a shopper-facing card
                        change nobody has verified. Leave off until a repointed subscription has been seen to
                        renew on the new card with that card's own network transaction id.</description>
                    <modifiers optional="false"/>
                    <persistence type="property"/>
                    <defaultvalue>Boolean.FALSE</defaultvalue>
                </attribute>
                <attribute qualifier="networkTransactionIdOnBillingInfoEnabled" type="java.lang.boolean">
                    <description>Send the Adyen network transaction id alongside the imported token when a
                        billing info is created. Recurly documents NTIDs as accepted only on /subscriptions
                        and /purchases, so this is unproven: off, an import behaves exactly as before; on,
                        Recurly may reject the whole import. Turn it on only to establish what Recurly does
                        with the field, and only once both NTID support flags are confirmed enabled.</description>
                    <modifiers optional="false"/>
                    <persistence type="property"/>
                    <defaultvalue>Boolean.FALSE</defaultvalue>
                </attribute>
                <attribute qualifier="promoteChosenCardToPrimary" type="java.lang.boolean">
                    <description>After a shopper points a subscription at a card, also make that card the
                        account's primary billing info. Account-wide: every subscription of theirs that is
                        not pinned to a specific billing info follows the primary and moves with it, and
                        Recurly attempts collection on unpaid invoices tied to the updated billing info.
                        Off by default, because the subscription the shopper acted on is pinned already and
                        does not need it.</description>
                    <modifiers optional="false"/>
                    <persistence type="property"/>
                    <defaultvalue>Boolean.FALSE</defaultvalue>
                </attribute>
                <attribute qualifier="hostedPagesHost" type="java.lang.String">
                    <description>Host serving this site's Recurly hosted pages, host only and no scheme or
                        path, e.g. mystore.recurly.com. Recurly's API hands out no link to them, so the
                        address is assembled from this plus the account's hosted login token; copy the host
                        out of the Account Management URL shown in the Recurly admin, which is also what
                        makes this correct on sites not served from recurly.com.</description>
                    <persistence type="property">
                        <columntype>
                            <value>varchar(255)</value>
                        </columntype>
                    </persistence>
                </attribute>
                <attribute qualifier="hostedAccountManagementEnabled" type="java.lang.boolean">
                    <description>Offer shoppers a link to Recurly's own hosted account management page, where
                        they can give Recurly a card it collects itself. Requires Hosted Account Management to
                        be switched on in the Recurly admin and a hostedPagesHost here; with either missing the
                        link is not offered. Note what the page does: it shows and edits the PRIMARY billing
                        info only, so a shopper cannot add a second card to the wallet from it, and the link
                        carries a token that opens the whole account.</description>
                    <modifiers optional="false"/>
                    <persistence type="property"/>
                    <defaultvalue>Boolean.FALSE</defaultvalue>
                </attribute>
            </attributes>
        </itemtype>

        <itemtype code="BaseStore" autocreate="false" generate="false">
            <attributes>
                <!-- Credentials per platform are kept side by side so switching platforms does not require
                     retyping the other's keys. -->
                <attribute qualifier="recurlyConfig" type="RecurlyConfig">
                    <persistence type="property"/>
                </attribute>
            </attributes>
        </itemtype>

        <itemtype code="RecurlyPlanMapping" extends="GenericItem" autocreate="true" generate="true">
            <deployment table="RecurlyPlanMapping" typecode="22950"/>
            <attributes>
                <attribute qualifier="productCode" type="java.lang.String">
                    <description>SAP subscription product code. Unique together with baseStore.</description>
                    <persistence type="property"/>
                    <modifiers optional="false" unique="true"/>
                </attribute>
                <attribute qualifier="planCode" type="java.lang.String">
                    <description>Recurly plan code used on subscription creation.</description>
                    <persistence type="property"/>
                    <modifiers optional="false"/>
                </attribute>
                <attribute qualifier="priceId" type="java.lang.String">
                    <description>Optional Recurly price/currency reference for future catalog variants.</description>
                    <persistence type="property"/>
                </attribute>
                <attribute qualifier="baseStore" type="BaseStore">
                    <description>Store the mapping applies to. Empty = default for every store without its own
                        mapping of this product; a store's own mapping wins.</description>
                    <persistence type="property"/>
                    <modifiers unique="true"/>
                </attribute>
            </attributes>
            <indexes>
                <index name="idx_rcPlanMap_prodStore" unique="true">
                    <key attribute="productCode"/>
                    <key attribute="baseStore"/>
                </index>
            </indexes>
        </itemtype>

        <!-- Webhook deduplication deliberately has no Recurly-specific type. It lives once, in
             adyensubscriptionconnector's BillingWebhookEvent, where the unique index on
             (platform, eventId) is what actually enforces it. -->
    </itemtypes>

</items>
